# =============================================================================
# PRODUCTION environment — used by docker-compose.prod.yml
#
# THIS FILE SHOULD NOT CONTAIN REAL SECRETS IN A REAL DEPLOYMENT.
# Treat it as a template. On an actual production host / CI pipeline, inject
# DATABASE_URL via your secret manager instead of committing real values here:
#   - Docker Swarm / Compose:  `docker secret` or a CI-generated .env.production
#   - Kubernetes:              Secret mounted as env var
#   - AWS ECS:                 Secrets Manager / SSM Parameter Store
#   - Render/Fly/Railway/etc.: built-in environment variable / secrets UI
# =============================================================================

NODE_ENV=production
PORT=3000

