# =============================================================================
# DEVELOPMENT environment — used by docker-compose.dev.yml
# Safe to keep out of git ONLY because these are your personal dev credentials.
# Get NEON_API_KEY / NEON_PROJECT_ID / PARENT_BRANCH_ID from the Neon Console:
# https://console.neon.tech -> your project -> Settings
# =============================================================================

NODE_ENV=development
PORT=3000

# --- Neon Local / Neon API ---
NEON_API_KEY=napi_c9zag9heq5rtkni078un2kiggdc1mraveisrxg3ro2nkemk9912r6ppvl18fw809
NEON_PROJECT_ID=fragrant-shadow-56291046
# The branch that new ephemeral dev branches are forked FROM (usually your
# main/production branch's ID). Neon Local creates a new child branch off
# this every time the container starts, and deletes it on shutdown.
PARENT_BRANCH_ID=ep-snowy-dawn-az9fvaeb

ARCJET_KEY=ajkey_01m14p6m6nfd19320ktcyjt1rh

# Name of the database inside the branch (matches what's in your Neon project)
DB_NAME=neondb

# --- App connection string ---
# This value is fixed by convention: Neon Local always listens on port 5432
# inside the compose network under the service name "neon-local", and always
# accepts the static user/password below — it swaps the *actual* branch
# underneath transparently. You normally never need to change this line.
DATABASE_URL=postgresql://neondb_owner:npg_AKudamF6B4ZL@ep-polished-darkness-azoeuuun-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
