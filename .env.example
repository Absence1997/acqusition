# Copy this to .env.development or .env.production and fill in real values.
# This file itself contains no secrets and is safe to commit.

NODE_ENV=development
PORT=3000

# --- Required for DEVELOPMENT (docker-compose.dev.yml / Neon Local) ---
NEON_API_KEY=
NEON_PROJECT_ID=
PARENT_BRANCH_ID=
DB_NAME=neondb
# Fixed convention when using Neon Local — usually leave as-is:
DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb?sslmode=no-verify

# --- Required for PRODUCTION (docker-compose.prod.yml / Neon Cloud) ---
# Overwrite DATABASE_URL above with your real Neon Cloud string when
# building .env.production, e.g.:
# DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
